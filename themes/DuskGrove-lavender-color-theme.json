  "tokenColors": [
    {
      "name": "Comments and comment punctuation",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.block.documentation",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#657668",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords, control flow, and storage modifiers",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E8B38A"
      }
    },
    {
      "name": "Strings, quoted values, and template literals",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#97B5CB"
      }
    },
    {
      "name": "Numbers, numeric units, and language constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D0D7B7"
      }
    },
    {
      "name": "Function definitions, invocations, and built-in functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#86BFAD"
      }
    },
    {
      "name": "Types, classes, interfaces, primitives, and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#A8D5C8"
      }
    },
    {
      "name": "Variables, parameters, and identifiers",
      "scope": ["variable", "variable.other", "variable.parameter", "meta.parameter"],
      "settings": {
        "foreground": "#B0AEA6"
      }
    },
    {
      "name": "Operators, delimiters, and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#77867B"
      }
    },
    {
      "name": "Markup and component tags",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#CF8B5A"
      }
    },
    {
      "name": "Attributes and object properties",
      "scope": ["entity.other.attribute-name", "meta.attribute", "support.type.property-name"],
      "settings": {
        "foreground": "#E2CAA6"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "heading.1.markdown",
        "heading.2.markdown",
        "heading.3.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#E8B38A"
      }
    },
    {
      "name": "Markdown links and raw URLs",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#86BFAD"
      }
    },
    {
      "name": "Markdown bold text",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#D0D7B7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic text",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#A8D5C8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON property keys",
      "scope": [
        "support.type.property-name.json",
        "source.json meta.structure.dictionary.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#E2CAA6"
      }
    },
    {
      "name": "Invalid syntax or deprecated constructs",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#D9707A"
      }
    },
    {
      "name": "Deprecated syntax",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#E0B168"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#86BFAD",
    "function.declaration": "#86BFAD",
    "method": "#86BFAD",
    "method.declaration": "#86BFAD",
    "macro": "#86BFAD",
    "variable": "#B0AEA6",
    "variable.declaration": "#B0AEA6",
    "variable.readonly": "#B0AEA6",
    "variable.defaultLibrary": "#B0AEA6",
    "parameter": "#B0AEA6",
    "property": "#E2CAA6",
    "property.declaration": "#E2CAA6",
    "property.readonly": "#E2CAA6",
    "enumMember": "#D0D7B7",
    "class": "#A8D5C8",
    "interface": "#A8D5C8",
    "enum": "#A8D5C8",
    "type": "#A8D5C8",
    "typeParameter": "#A8D5C8",
    "struct": "#A8D5C8",
    "namespace": "#A8D5C8",
    "keyword": "#E8B38A",
    "string": "#97B5CB",
    "number": "#D0D7B7",
    "operator": "#77867B",
    "comment": {
      "foreground": "#657668",
      "fontStyle": "italic"
    }
  }
}
