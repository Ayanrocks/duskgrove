  "tokenColors": [
    {
      "name": "Comments and comment punctuation",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5F665A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords, control flow, and storage modifiers",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#A68FD1"
      }
    },
    {
      "name": "Strings, quoted values, and template literals",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#A3C98F"
      }
    },
    {
      "name": "Numbers, numeric units, and language constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D9B97A"
      }
    },
    {
      "name": "Function definitions, invocations, and built-in functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8AB4D8"
      }
    },
    {
      "name": "Types, classes, interfaces, primitives, and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#7FC4B8"
      }
    },
    {
      "name": "Variables, parameters, and identifiers",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#C7CDB9"
      }
    },
    {
      "name": "Operators, delimiters, and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#6F6A7A"
      }
    },
    {
      "name": "Markup and component tags",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#D18FA8"
      }
    },
    {
      "name": "Attributes and object properties",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#C9A875"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "heading.1.markdown",
        "heading.2.markdown",
        "heading.3.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#A68FD1"
      }
    },
    {
      "name": "Markdown links and raw URLs",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#8AB4D8"
      }
    },
    {
      "name": "Markdown bold text",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D9B97A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic text",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#7FC4B8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON property keys",
      "scope": [
        "support.type.property-name.json",
        "source.json meta.structure.dictionary.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#C9A875"
      }
    },
    {
      "name": "Invalid syntax or deprecated constructs",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#D9707A"
      }
    },
    {
      "name": "Deprecated syntax",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#E0B168"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#8AB4D8",
    "function.declaration": "#8AB4D8",
    "method": "#8AB4D8",
    "method.declaration": "#8AB4D8",
    "macro": "#8AB4D8",
    "variable": "#C7CDB9",
    "variable.declaration": "#C7CDB9",
    "variable.readonly": "#C7CDB9",
    "variable.defaultLibrary": "#C7CDB9",
    "parameter": "#C7CDB9",
    "property": "#C9A875",
    "property.declaration": "#C9A875",
    "property.readonly": "#C9A875",
    "enumMember": "#D9B97A",
    "class": "#7FC4B8",
    "interface": "#7FC4B8",
    "enum": "#7FC4B8",
    "type": "#7FC4B8",
    "typeParameter": "#7FC4B8",
    "struct": "#7FC4B8",
    "namespace": "#7FC4B8",
    "keyword": "#A68FD1",
    "string": "#A3C98F",
    "number": "#D9B97A",
    "operator": "#6F6A7A",
    "comment": {
      "foreground": "#5F665A",
      "fontStyle": "italic"
    }
  }
}
